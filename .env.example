# =====================================================
# GITHUB APP CONFIGURATION
# =====================================================
# GitHub App ID - Found in GitHub App settings under "About"
GITHUB_APP_ID=123456

# GitHub App Private Key - Generate in GitHub App settings under "Private keys"
# Copy the entire contents of the .pem file
# This is sensitive - never commit to git
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Webhook Secret - Create a random string in GitHub App settings under "Webhook"
# Use: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here_32_characters

# =====================================================
# DEPLOYMENT CONFIGURATION
# =====================================================
# Your domain name where the app will be accessible
DOMAIN=your-domain.com

# Email for Let's Encrypt certificate notifications
LETSENCRYPT_EMAIL=your-email@example.com

# =====================================================
# DEEPSEEK API CONFIGURATION
# =====================================================
# DeepSeek API key for AI summarization
DEEPSEEK_API_KEY=your_deepseek_api_key

# DeepSeek model to use for summarization
DEEPSEEK_MODEL=deepseek-chat

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# PostgreSQL password (must match the password in DATABASE_URL below)
POSTGRES_PASSWORD=your_postgres_password

# PostgreSQL connection string
DATABASE_URL=postgresql://pr_app:your_postgres_password@postgres:5432/pr_summary_db

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
# Port the application listens on (internal)
PORT=3000

# Environment: production or development
NODE_ENV=production

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Maximum concurrent processing jobs
MAX_CONCURRENT_JOBS=5

# DeepSeek request timeout in milliseconds
DEEPSEEK_TIMEOUT=60000

# Maximum diff size to include in AI prompt (in characters)
MAX_DIFF_SIZE=50000

# Enable verbose logging for debugging
DEBUG=false
